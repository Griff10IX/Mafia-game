# systemd unit for cron-cycle-ticker.py (main Auto Rank: crimes, GTA, booze, OC)
# Interval is read from Admin (API); run BOTH this and cron-bust-ticker for full Auto Rank.
#
# Install: see scripts/README-cron-bust.md "Run both tickers on the server"
#   1. sudo cp scripts/cron-cycle-ticker.service.example /etc/systemd/system/cron-cycle-ticker.service
#   2. Replace /path/to/Game-files-mafia with your project root in WorkingDirectory and ExecStart
#   3. backend/.env must have CRON_SECRET and BASE_URL
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now cron-cycle-ticker
# Logs: journalctl -u cron-cycle-ticker -f

[Unit]
Description=Auto Rank main cycle ticker (crimes/GTA/booze/OC)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/Game-files-mafia
ExecStart=/usr/bin/python3 /path/to/Game-files-mafia/scripts/cron-cycle-ticker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
