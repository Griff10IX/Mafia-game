# Nginx config for mafiawars.co.uk with HTTP→HTTPS redirect
# Copy this structure into /etc/nginx/sites-available/mafia on the server.
# Certbot usually puts certs in /etc/letsencrypt/live/mafiawars.co.uk/

# Block 1: Port 80 – redirect only (no root, no location)
server {
    listen 80;
    server_name mafiawars.co.uk www.mafiawars.co.uk;
    return 301 https://$host$request_uri;
}

# Block 2: Port 443 – serve the app (HTTPS)
server {
    listen 443 ssl;
    server_name mafiawars.co.uk www.mafiawars.co.uk;

    # SSL (Certbot sets these; path may be /etc/letsencrypt/live/mafiawars.co.uk/)
    ssl_certificate     /etc/letsencrypt/live/mafiawars.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mafiawars.co.uk/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Default nginx is 1m; avatar data URLs (~1.2MB+) otherwise get HTTP 413 before the API runs.
    client_max_body_size 10M;

    root /opt/mafia-app/build;
    index index.html;

    # SPA shell only: avoid caching index.html at browser/CDN so a transient 503 or bad deploy
    # is less likely to stick (Chrome may show "503 from prefetch cache" on deep links like
    # /account/dashboard if a speculative prefetch got an error). Static JS/CSS under /static/
    # keep long cache from create-react-app filenames.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location /api {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Static assets under /images/: never fall through to index.html. If a file is missing,
    # return 404 instead of SPA HTML — otherwise Cloudflare can cache text/html for an image
    # URL and GTA/garage thumbnails stay blank until the cache is purged or ?v= is bumped.
    location /images/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public" always;
    }

    # Required for SPA: /travel/, /account/dashboard, etc. must serve index.html so React Router
    # can run. Without try_files, deep links often 404/403. If you still see 503, the origin was
    # down, nginx misconfigured, or Cloudflare could not reach origin (orange-cloud proxy still
    # uses Cloudflare IPs like 2606:4700:*). Purge CF cache; avoid "Cache Everything" for HTML.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
