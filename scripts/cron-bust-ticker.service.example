# systemd unit for cron-bust-ticker.py (jail bust every 5s when AUTO_RANK_USE_CRON=1)
#
# Install:
#   1. Copy to systemd user or system dir:
#        cp scripts/cron-bust-ticker.service.example /etc/systemd/system/cron-bust-ticker.service
#   2. Edit and set the correct path for your project (replace /path/to/Game-files-mafia):
#        WorkingDirectory= and ExecStart=
#   3. Ensure backend/.env has CRON_SECRET and BASE_URL (or set in the [Service] block with Environment=).
#   4. Reload and enable:
#        sudo systemctl daemon-reload
#        sudo systemctl enable cron-bust-ticker
#        sudo systemctl start cron-bust-ticker
#   5. Check status: sudo systemctl status cron-bust-ticker
#
# Logs: journalctl -u cron-bust-ticker -f

[Unit]
Description=Auto Rank jail bust ticker (every 5s)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/Game-files-mafia
ExecStart=/usr/bin/python3 /path/to/Game-files-mafia/scripts/cron-bust-ticker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
