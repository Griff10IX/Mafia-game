# systemd unit for cron-bust-ticker.py (jail bust; interval from Admin)
# Run BOTH this and cron-cycle-ticker for full Auto Rank. See scripts/README-cron-bust.md
#
# Install: replace /path/to/Game-files-mafia, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now cron-bust-ticker
# Logs: journalctl -u cron-bust-ticker -f

[Unit]
Description=Auto Rank jail bust ticker
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/Game-files-mafia
ExecStart=/usr/bin/python3 /path/to/Game-files-mafia/scripts/cron-bust-ticker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
