# ============================================================================
# MAFIA GAME – FULL .env (copy to /opt/mafia-app/backend/.env on server)
# ============================================================================
# Replace every YOUR_... / placeholder with your real values. Never commit .env.

# ============================================================================
# DATABASE (MongoDB)
# ============================================================================
MONGO_URL=mongodb+srv://doadmin:YOUR_MONGO_PASSWORD@db-mongodb-lon1-69838-7a7b2545.mongo.ondigitalocean.com/mafia_game?tls=true&authSource=admin
DB_NAME=mafia_game

# ============================================================================
# SECURITY
# ============================================================================
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
# Optional: default is 1440 (24h). E.g. 10080 = 7 days.
# JWT_EXPIRE_MINUTES=10080
# Optional: session ends after this many minutes with no requests. Default 1440 (24h). Set 0 to disable (only JWT expiry applies).
# SESSION_INACTIVITY_MINUTES=10080

# CORS – comma-separated origins (production: your frontend URL)
CORS_ORIGINS=https://mafiawars.co.uk

# Admin emails (comma-separated; admin access in game)
ADMIN_EMAILS=jakeg_lfc2016@icloud.com

# ============================================================================
# API KEYS (Optional)
# ============================================================================
# The Odds API (sports betting) – https://the-odds-api.com
THE_ODDS_API_KEY=YOUR_ODDS_API_KEY

# Giphy (chat GIFs) – https://developers.giphy.com/dashboard
GIPHY_API_KEY=YOUR_GIPHY_API_KEY

# Stripe (store / payments)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_KEY
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ============================================================================
# TELEGRAM (Security alerts)
# ============================================================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ============================================================================
# EMAIL – Resend (use this on DigitalOcean; SMTP is blocked)
# ============================================================================
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
MAIL_FROM="Mafia Wars <noreply@mafiawars.co.uk>"
FRONTEND_URL=https://mafiawars.co.uk

# (Leave SMTP unset when using Resend)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================================================
# REGISTRATION PROTECTION (Optional)
# ============================================================================
# GetIPIntel – block proxy/VPN at signup. Set your email for their ToS.
GETIPINTEL_CONTACT_EMAIL=your@email.com

# ============================================================================
# AUTO RANK CRON
# ============================================================================
AUTO_RANK_USE_CRON=1
CRON_SECRET=YOUR_CRON_SECRET
BASE_URL=https://mafiawars.co.uk

# ============================================================================
# MISSIONS / TRIBUTE (Optional – defaults used if unset)
# ============================================================================
# TRIBUTE_DEPOSIT_UTC_HOUR=17
# DAILY_TRIBUTE_AMOUNT=500
# DAILY_TRIBUTE_LOOT_BOX_PIECES=1
# MISSION_2_DAILY_LOOT_BOX_PIECES=1

# ============================================================================
# PRODUCTION
# ============================================================================
PRODUCTION=true
