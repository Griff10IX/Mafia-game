# ============================================================================
# MAFIA GAME - ENVIRONMENT VARIABLES (Production Template)
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - only commit .env.example

# ============================================================================
# DATABASE (MongoDB)
# ============================================================================
# LOCAL (Development):
# MONGO_URL="mongodb://localhost:27017"
# DB_NAME="test_database"

# PRODUCTION (DigitalOcean with Authentication):
MONGO_URL="mongodb://mafiaAppUser:YOUR_STRONG_PASSWORD@localhost:27017/mafia_game?authSource=mafia_game"
DB_NAME="mafia_game"
# Optional: cap app connections (default 25). Raise on larger Mongo plans if needed.
# MONGO_MAX_POOL_SIZE=25

# ⚠️ NEVER use these insecure formats in production:
# ❌ mongodb://0.0.0.0:27017 (exposed to internet)
# ❌ mongodb://localhost:27017 (no authentication)
# ✅ mongodb://username:password@localhost:27017/dbname?authSource=dbname (secure)

# ============================================================================
# SECURITY
# ============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="GENERATE_NEW_SECRET_HERE"

# HTTP access: default logs one compact line per request (METHOD path status user) via middleware logger "http".
# REQUEST_LOGGING_ENABLED=0 turns that off.
# REQUEST_LOGGING_ERRORS_ONLY=1 logs only status >= 400 (quiet under normal traffic).
# UVICORN_ACCESS_LOG=1 re-enables uvicorn's default access line (duplicate with middleware unless middleware is off).
# Production systemd example uses uvicorn --no-access-log so journal is not doubled.

# SecurityMiddleware enforces IP bans only (Phase 0: page-visit / mutating spam / endpoint RL removed).

# CORS - Comma-separated list of allowed origins
# Development: "*" (allow all)
# Production: "https://your-frontend.vercel.app,https://yourdomain.com"
CORS_ORIGINS="*"

# Extra domains blocked for player signup / preregister (merged with built-in game domain blocklist).
# Built-in always includes mafiawars.co.uk so players use personal mail; staff addresses stay on that domain for ops only.
# REGISTRATION_BLOCKED_DOMAINS=

# Comma-separated emails (lowercase) excluded from admin cheat-detection batch reports (same-IP, dupe-check-intelligent, etc.)
# and shown deterministic synthetic data on GET /admin/investigate/user-ip-check. Does NOT grant admin powers.
# Does not remove accounts from user search — set only on trusted hosts; real IPs remain in MongoDB.
# DUPE_DETECTION_EXEMPT_EMAILS=

# Comma-separated staff emails (production). Lowercased when read; matches user email case-insensitively in code.
# ADMIN_EMAILS="ops@example.com,finance@example.com"
# MOD_EMAILS="mod1@example.com,mod2@example.com"
# (alias: MODERATOR_EMAILS — same as MOD_EMAILS if you prefer the longer name)
#
# Optional staff UI/API second factor: when set, /api/.../admin/... requires header X-Staff-Portal-Token
# from POST /api/auth/staff-portal-unlock (admins/mods only). Default session length 30 minutes.
# STAFF_PORTAL_PASSWORD="generate-a-long-random-secret"
# STAFF_PORTAL_SESSION_MINUTES=30

# ============================================================================
# API KEYS (Optional Services)
# ============================================================================
# The Odds API (Sports Betting)
# Get a key at: https://the-odds-api.com
# Set this on the API server (same .env / systemd / host env as this app). Needed for live Football, Basketball (NBA), Tennis, Golf (h2h keys), UFC, Boxing, F1 (h2h)
# odds and for POST /api/sports-betting/cron/auto-settle (auto-settle calls The Odds API).
# scripts/cron-sports-settle.py only needs CRON_SECRET + BASE_URL; it does not need THE_ODDS_API_KEY.
THE_ODDS_API_KEY=your_key_here
# Optional: comma-separated The Odds API sport keys for Snooker h2h odds (used when /v4/sports does not list snooker yet).
# SNOOKER_ODDS_SPORT_KEYS=snooker_example_key
# Optional: comma-separated sport keys for Tennis / Golf when auto-discovery returns nothing (h2h-style keys only).
# TENNIS_ODDS_SPORT_KEYS=tennis_atp_australian_open
# GOLF_ODDS_SPORT_KEYS=
# Optional free fallback (Football results) used by auto-settle if Odds API is down/unauthorized.
# Get free key at https://www.football-data.org/ and set:
FOOTBALL_DATA_ORG_TOKEN=
# Optional: cache The Odds API JSON in Mongo (sports_odds_api_cache) to save request quota (defaults shown).
# SPORTS_ODDS_CACHE_TTL_SEC=1800
# SPORTS_ODDS_SCORES_CACHE_TTL_SEC=900
# SPORTS_ODDS_FETCH_CONCURRENCY=4
# Sports bet wins: credit swiss_balance (not subject to Swiss deposit cap). Set to 0/false/no/off to pay cash (money) instead.
# SPORTS_PAYOUT_TO_SWISS=0

# Giphy API (Chat GIFs)
# Get free key at: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=your_key_here

# Stripe (Payments - Store points packages). Use test key (sk_test_...) for testing.
# Set one of these; STRIPE_SECRET_KEY is preferred.
STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_API_KEY=sk_test_your_key
# Optional: for webhook (production) set STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# TELEGRAM NOTIFICATIONS (Security Alerts)
# ============================================================================
# 1. Create bot: Message @BotFather on Telegram, use /newbot
# 2. Get bot token from @BotFather
# 3. Get your chat ID: Message @userinfobot on Telegram
# 4. Start a chat with your bot first!
# For Auto Rank Telegram commands (/autorank, /summary, /enable, /disable): set TELEGRAM_WEBHOOK_BASE_URL (or BASE_URL) to your public API URL (HTTPS). Server will register the webhook and command menu on startup.
# Example: TELEGRAM_WEBHOOK_BASE_URL=https://api.mafiawars.co.uk
# Optional: TELEGRAM_WEBHOOK_SECRET — if set, Telegram sends it as X-Telegram-Bot-Api-Secret-Token (verify in webhook handler).
TELEGRAM_BOT_TOKEN=8227124202:AAGhj8e8WRrhwXkvGm1IB-iTlR7xRL655II
TELEGRAM_CHAT_ID=-5266781777
# TELEGRAM_WEBHOOK_BASE_URL=https://your-api-domain.com
# TELEGRAM_WEBHOOK_SECRET=optional-secret

# ============================================================================
# EMAIL (Verification & password reset)
# ============================================================================
# Use ONE of: SMTP (e.g. IONOS Mail) or Resend. If neither is set, links are created but not emailed (dev).

# --- Option A: SMTP (e.g. IONOS Mail – admin@mafiawars.co.uk)
# IONOS: host smtp.ionos.co.uk (or smtp.ionos.com), port 587, user = full email, password = mailbox password.
# Some hosts (e.g. DigitalOcean) may block outbound SMTP; if so use Resend or another provider.
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=admin@mafiawars.co.uk
SMTP_PASSWORD=your_mailbox_password
# SMTP_USE_TLS=true

# --- Option B: Resend (works from DigitalOcean)
# Get API key at https://resend.com/api-keys. Verify your domain at https://resend.com/domains
RESEND_API_KEY=
MAIL_FROM="Mafia Wars <admin@mafiawars.co.uk>"
# Frontend base URL for verification and reset links (e.g. https://mafiawars.co.uk)
FRONTEND_URL="http://localhost:3000"

# Admin "inactive reminder" email (POST /admin/users/inactivity-reminder-email): require last_seen older than N days; block re-send within cooldown days.
# INACTIVITY_REMINDER_MIN_DAYS=3
# INACTIVITY_REMINDER_COOLDOWN_DAYS=7

# ============================================================================
# REGISTRATION PROTECTION (Optional)
# ============================================================================
# Block proxy/VPN at signup: set your email for GetIPIntel (required by their ToS).
# If set, registration from IPs detected as proxy/VPN will be rejected.
# Leave empty to allow all IPs. Free tier: 500/day, 15/min.
GETIPINTEL_CONTACT_EMAIL=your@email.com
# Optional: stricter signup/login proxy check (dynamic GetIPIntel score, not ban-list-only).
# GETIPINTEL_AUTH_STRICT=true
# GETIPINTEL_AUTH_STRICT_THRESHOLD=0.97

# Optional: ipapi.is API key for admin IP lookup (free tier ~1000/day without key; key raises limits).
# IPAPI_IS_API_KEY=

# ============================================================================
# AUTO RANK CRON (production: cron + ticker instead of in-process loops)
# ============================================================================
# Set AUTO_RANK_USE_CRON=1 when you drive Auto Rank via cron (and cron-bust-ticker).
# Then run scripts/cron-cycle-ticker.py so POST /api/auto-rank/cron is called often
# (crontab alone runs only every 60s). cron-bust-ticker calls POST /api/auto-rank/cron-bust every 5s.
# AUTO_RANK_USE_CRON=1
# CRON_SECRET=your-secret-same-as-crontab
# BASE_URL=http://127.0.0.1:8000
# CRON_CYCLE_INTERVAL=5
# CRON_BUST_INTERVAL=5
#
# --- Sports betting auto-settle (payout winners from Odds API scores) ---
# Production checklist:
#   1) API server .env: THE_ODDS_API_KEY (required for score polling).
#   2) API server .env: CRON_SECRET (shared secret for POST /api/sports-betting/cron/auto-settle).
#   3) Scheduler: call the cron endpoint every 15–30 minutes, e.g. crontab:
#        */30 * * * * cd /path/to/repo && python scripts/cron-sports-settle.py --once
#      Set BASE_URL to your API origin WITHOUT the /api suffix — the script calls {BASE_URL}/api/sports-betting/cron/auto-settle.
#        BASE_URL=https://api.example.com   OR   BASE_URL=http://127.0.0.1:8000
#   4) Only events created from templates with external_event_id + external_sport_key auto-settle; custom events need manual Settle.
# Optional: after admin "Check for events" refresh, also run auto-settle once (uses more Odds API quota):
# SPORTS_AUTO_SETTLE_ON_REFRESH=1
# Manual (no cron secret): admins can POST /api/admin/sports-betting/auto-settle-run while logged in (Sports Betting admin panel).
#
# --- Sports auto-board (promote saved templates to the public bettable board) ---
# Cron (same CRON_SECRET as auto-settle): POST /api/sports-betting/cron/auto-board with header X-Cron-Secret.
# Default: reads MongoDB sports_betting_templates only (same pool as admin "Load saved (DB)") — no Odds API on this path.
# Staff should run admin "Check for events" periodically so the template library stays filled; auto-board then boards eligible games.
# Schedule ~every 2 hours. Daily cap SPORTS_AUTO_BOARD_DAILY_ADD_LIMIT (default 55 in code) across auto_board events.
# SPORTS_AUTO_BOARD_TEMPLATE_SOURCE=database   # default; use "merged" to restore Odds refresh + in-memory merge for auto-board
# SPORTS_AUTO_BOARD_TICKER_INTERVAL_SEC=7200   # default 2h in-process ticker sleep between runs
# SPORTS_AUTO_BOARD_MAX=40                     # optional per-run/daily-style cap (clamped to daily limit)
# Optional comma list overriding default football keys (default = full SOCCER_LEAGUES list in sports_betting.py):
# SPORTS_AUTO_BOARD_SOCCER_KEYS=soccer_epl,soccer_uefa_champs_league
# Manual: POST /api/admin/sports-betting/auto-board-run while logged in; JSON optional:
#   {"template_source": "database"} or {"template_source": "merged", "refresh_odds": true}
#
# In-process ticker (alternative to cron): polls Odds API only after kickoff + delay for open linkable events.
# Do not enable together with a frequent cron on the same host (duplicate work). Prefer one or the other.
# SPORTS_AUTO_SETTLE_TICKER=1
# SPORTS_AUTO_SETTLE_USE_CRON=1   # if set, ticker is NOT started — use external cron only
# SPORTS_AUTO_SETTLE_MINUTES_AFTER_START=100   # wait this many minutes after start_time before polling may run
# SPORTS_AUTO_SETTLE_TICKER_IDLE_SEC=600       # sleep when no linkable open events (default 10 min)
# SPORTS_AUTO_SETTLE_TICKER_POLL_INTERVAL_SEC=180   # sleep after each poll while events may still be open (default 3 min)
# SPORTS_AUTO_SETTLE_TICKER_WAIT_CAP_SEC=900   # max sleep per wait toward kickoff+delay (default 15 min)
# Multi-worker: each uvicorn worker runs its own ticker if enabled — use a single worker or SPORTS_AUTO_SETTLE_USE_CRON=1.

# World Cup 2026 predictions (uses same THE_ODDS_API_KEY + CRON_SECRET as sports betting)
# POST /api/world-cup/cron/sync-fixtures daily; POST /api/world-cup/cron/auto-settle every 30 min
# WORLD_CUP_AUTO_SETTLE_USE_CRON=1
# WORLD_CUP_AUTO_SETTLE_TICKER=0
# WORLD_CUP_SYNC_USE_CRON=1
# WORLD_CUP_SYNC_TICKER=0
# WORLD_CUP_AUTO_SETTLE_MINUTES_AFTER_START=122
# WORLD_CUP_SETTLE_INTERVAL=1800
# WORLD_CUP_AUTO_DRAFT_USE_CRON=1
# WORLD_CUP_AUTO_DRAFT_TICKER=0
# WORLD_CUP_AUTO_DRAFT_INTERVAL_SEC=900
# Schedule scripts/cron-world-cup-draft.py every ~15 min (runs draft exactly 24h before first match kickoff).

# ============================================================================
# PRODUCTION FLAGS
# ============================================================================
PRODUCTION=true
