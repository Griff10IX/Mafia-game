# Copy to .env and fill in your keys.

# Optional: API origin for web / Capacitor iOS (HTTPS, no trailing /api). Empty = same host as the page (e.g. nginx proxies /api).
# REACT_APP_BACKEND_URL=https://your-server.example.com

# Giphy API (for GIF search in Inbox and Chat). Add to backend/.env — get a key at https://developers.giphy.com/dashboard/
# GIPHY_API_KEY=
